# =========================================================
# 丝路新声 后端环境变量示例
# 复制本文件为 .env 并填入真实密钥；.env 已被 gitignore，勿提交
# =========================================================

# ---- 服务端口（默认 3001）----
PORT=3001

# ---- DeepSeek 翻译（OpenAI 兼容接口）----
# 获取：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 小米 MiMo V2.5 TTS（中文 / 英语）----
# 获取：https://platform.xiaomimimo.com/console/api-keys （限时免费）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-tts
# 音色（年轻自然）：中文 冰糖(女)/白桦(男)；英文 Mia(女)/Dean(男)
MIMO_VOICE_ZH=冰糖
MIMO_VOICE_EN=Mia

# ---- TTS 路由（可选，默认 zh→mimo / ms→edge / en→mimo）----
# TTS_ROUTING_ZH=mimo
# TTS_ROUTING_MS=edge
# TTS_ROUTING_EN=mimo

# ---- 马来语 TTS：edge-tts（免费、零 key，需 pip install edge-tts）----
# 无需额外配置；若需指定音色可改 tts.ts 中 EDGE_VOICES

# ---- TTSmaker（保留适配器，马来语已改用 edge-tts）----
# 获取：https://ttsmaker.com 控制台；voice_id 为数字字符串
TTSMAKER_TOKEN=
TTSMAKER_BASE_URL=https://api.ttsmaker.com/v1
TTSMAKER_VOICE_MS=

# ---- 讯飞 / Azure TTS（预留，暂未接入）----
# IFLYTEK_APP_ID=
# IFLYTEK_API_KEY=
# IFLYTEK_API_SECRET=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia

# ---- 智能问答 LLM（预留适配器，OpenAI 兼容）----
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
